#!/bin/bash
# broadcast-start-ngrok - Start broadcasting with ngrok
# Uses Python server + ngrok (more reliable than localtunnel)

# Configuration
SHARE_DIR="/mnt/c/terminal_share"
LOG_FILE="$SHARE_DIR/server_output.txt"
URL_FILE="$SHARE_DIR/student_url.txt"
SERVER_PID="/tmp/broadcast_server.pid"
TUNNEL_PID="/tmp/tunnel.pid"
TUNNEL_LOG="/tmp/tunnel.log"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

echo "=========================================="
echo "  LGM Terminal Broadcast - NGROK"
echo "=========================================="

# Step 1: Check if ngrok is configured
if ! ngrok config check > /dev/null 2>&1; then
    echo "[ERROR] ngrok is not configured!"
    echo ""
    echo "Please run:"
    echo "  ngrok config add-authtoken YOUR_TOKEN"
    echo ""
    echo "Get your token at: https://dashboard.ngrok.com/get-started/your-authtoken"
    exit 1
fi

# Step 2: Create shared folder if missing
if [ ! -d "$SHARE_DIR" ]; then
    mkdir -p "$SHARE_DIR"
    echo "[OK] Created shared folder: $SHARE_DIR"
else
    echo "[OK] Shared folder exists: $SHARE_DIR"
fi

# Step 3: Check if already running
if [ -f "$SERVER_PID" ] && kill -0 $(cat "$SERVER_PID") 2>/dev/null; then
    echo "[!] Broadcast already running. Use 'broadcast-stop' first."
    exit 1
fi

# Step 4: Create empty log file if missing
if [ ! -f "$LOG_FILE" ]; then
    touch "$LOG_FILE"
    echo "[OK] Created log file: $LOG_FILE"
else
    echo "[OK] Log file exists: $LOG_FILE"
fi

# Step 5: Kill any old processes
pkill -f "server.py" 2>/dev/null
pkill -f "python3.*8080" 2>/dev/null
pkill -f "ngrok" 2>/dev/null
pkill -f "lt --port" 2>/dev/null
sleep 1

# Step 6: Start Python web server
echo "[..] Starting web server..."
python3 "$SCRIPT_DIR/server.py" > /tmp/server.log 2>&1 &
echo $! > "$SERVER_PID"
sleep 2

# Verify server is running
if ! curl -s -o /dev/null -w "%{http_code}" http://localhost:8080 | grep -q "200"; then
    echo "[ERROR] Failed to start server. Check /tmp/server.log"
    cat /tmp/server.log
    exit 1
fi
echo "[OK] Web server running on port 8080"

# Step 7: Start ngrok tunnel
echo "[..] Creating ngrok tunnel..."
ngrok http 8080 --log=stdout > "$TUNNEL_LOG" 2>&1 &
echo $! > "$TUNNEL_PID"

# Wait for tunnel to connect
sleep 3

# Get the public URL from ngrok API
NGROK_URL=$(curl -s http://localhost:4040/api/tunnels 2>/dev/null | grep -o 'https://[^"]*' | head -1)

if [ -z "$NGROK_URL" ]; then
    echo "[ERROR] Failed to get ngrok URL. Check /tmp/tunnel.log"
    cat "$TUNNEL_LOG" | head -20
    exit 1
fi

# Save URL
echo "$NGROK_URL" > "$URL_FILE"

echo ""
echo "=========================================="
echo "  BROADCAST READY!"
echo "=========================================="
echo ""
echo "  STUDENT URL:"
echo "  $NGROK_URL"
echo ""
echo "  URL saved to: C:\\terminal_share\\student_url.txt"
echo ""
echo "=========================================="
echo ""
echo "  NEXT STEP - In PowerShell, run:"
echo "  Start-Transcript -Path 'C:\terminal_share\server_output.txt' -Append"
echo ""
echo "=========================================="
echo ""
echo "Use 'broadcast-status' to check status."
echo "Use 'broadcast-stop' to stop."
