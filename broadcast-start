#!/bin/bash
# broadcast-start - Start broadcasting PowerShell terminal output to students
# Uses Python server + localhost.run with auto-reconnect

# Configuration
SHARE_DIR="/mnt/c/terminal_share"
LOG_FILE="$SHARE_DIR/server_output.txt"
URL_FILE="$SHARE_DIR/student_url.txt"
TUNNEL_LOG="/tmp/tunnel.log"
SERVER_PID="/tmp/broadcast_server.pid"
TUNNEL_PID="/tmp/tunnel.pid"
KEEPER_PID="/tmp/tunnel_keeper.pid"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

echo "=========================================="
echo "  LGM Terminal Broadcast - Starting"
echo "=========================================="

# Step 1: Create shared folder if missing
if [ ! -d "$SHARE_DIR" ]; then
    mkdir -p "$SHARE_DIR"
    echo "[OK] Created shared folder: $SHARE_DIR"
else
    echo "[OK] Shared folder exists: $SHARE_DIR"
fi

# Step 2: Check if already running
if [ -f "$SERVER_PID" ] && kill -0 $(cat "$SERVER_PID") 2>/dev/null; then
    echo "[!] Broadcast already running. Use 'broadcast-stop' first or 'broadcast-status' to see URL."
    exit 1
fi

# Step 3: Create empty log file if missing
if [ ! -f "$LOG_FILE" ]; then
    touch "$LOG_FILE"
    echo "[OK] Created log file: $LOG_FILE"
else
    echo "[OK] Log file exists: $LOG_FILE"
fi

# Step 4: Kill any old processes
pkill -f "server.py" 2>/dev/null
pkill -f "python3.*8080" 2>/dev/null
pkill -f "ssh.*localhost.run" 2>/dev/null
pkill -f "tunnel-keeper" 2>/dev/null
sleep 1

# Step 5: Start Python web server
echo "[..] Starting web server..."
python3 "$SCRIPT_DIR/server.py" > /tmp/server.log 2>&1 &
echo $! > "$SERVER_PID"
sleep 2

# Verify server is running
if ! curl -s -o /dev/null -w "%{http_code}" http://localhost:8080 | grep -q "200"; then
    echo "[ERROR] Failed to start server. Check /tmp/server.log"
    cat /tmp/server.log
    exit 1
fi
echo "[OK] Web server running on port 8080"

# Step 6: Start tunnel with keeper (auto-reconnect)
echo "[..] Creating public tunnel with auto-reconnect..."
nohup bash "$SCRIPT_DIR/tunnel-keeper.sh" > /tmp/tunnel_keeper.log 2>&1 &
echo $! > "$KEEPER_PID"

# Wait for initial URL
for i in {1..20}; do
    sleep 1
    if [ -f "$URL_FILE" ]; then
        URL=$(cat "$URL_FILE")
        if [ -n "$URL" ]; then
            break
        fi
    fi
    echo -n "."
done
echo ""

if [ -z "$URL" ]; then
    echo "[ERROR] Failed to get public URL. Check internet connection."
    cat /tmp/tunnel_keeper.log
    exit 1
fi

echo ""
echo "=========================================="
echo "  BROADCAST READY!"
echo "=========================================="
echo ""
echo "  STUDENT URL (share this):"
echo "  $URL"
echo ""
echo "  URL saved to: C:\\terminal_share\\student_url.txt"
echo ""
echo "  NOTE: If tunnel reconnects, URL may change."
echo "        Check 'broadcast-status' for current URL."
echo ""
echo "=========================================="
echo ""
echo "  NEXT STEP - In PowerShell, run:"
echo "  Start-Transcript -Path 'C:\terminal_share\server_output.txt' -Append"
echo ""
echo "=========================================="
echo ""
echo "Broadcast running with AUTO-RECONNECT."
echo "Use 'broadcast-status' to see current URL."
echo "Use 'broadcast-stop' to stop."
